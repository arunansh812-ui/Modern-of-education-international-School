rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   return request.auth != null &&
     exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
     get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
  }
  match /circulars/{id} {
   allow read: if true;
   allow create: if admin() && request.resource.data.keys().hasOnly(['title','body','createdAt']) &&
    request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140 &&
    request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000 &&
    request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }
  match /admins/{uid} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow write: if false; // Create administrator grants manually in Firebase Console only.
  }
  match /{document=**} { allow read, write: if false; }
 }
}
